{
  "swagger": "2.0",
  "info": {"title": "Old API", "version": "1"},
  "host": "old.test",
  "basePath": "/api",
  "schemes": ["https"],
  "securityDefinitions": {"basic": {"type": "basic"}},
  "paths": {
    "/users/{id}": {
      "get": {
        "operationId": "getUser",
        "parameters": [{"name": "id", "in": "path", "required": true, "type": "integer"}],
        "responses": {"200": {"description": "ok", "schema": {"$ref": "#/definitions/User"}}}
      },
      "put": {
        "operationId": "updateUser",
        "parameters": [
          {"name": "id", "in": "path", "required": true, "type": "integer"},
          {"name": "user", "in": "body", "required": true, "schema": {"$ref": "#/definitions/User"}}
        ],
        "responses": {"200": {"description": "ok", "schema": {"$ref": "#/definitions/User"}}}
      }
    },
    "/avatars": {
      "post": {
        "operationId": "uploadAvatar",
        "consumes": ["multipart/form-data"],
        "parameters": [
          {"name": "image", "in": "formData", "type": "file", "required": true},
          {"name": "note", "in": "formData", "type": "string"}
        ],
        "responses": {"204": {"description": "ok"}}
      }
    }
  },
  "definitions": {
    "User": {"type": "object", "required": ["id"], "properties": {"id": {"type": "integer"}, "email": {"type": "string"}}}
  }
}
